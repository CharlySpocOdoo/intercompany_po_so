<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Hereda la vista formulario de Sale Order para agregar el campo intercompañía -->
    <record id="sale_order_intercompany_form_view" model="ir.ui.view">
        <field name="name">sale.order.intercompany.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Smart button: abre la PO intercompañía desde el button_box de la SO -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    class="oe_stat_button"
                    icon="fa-shopping-cart"
                    type="object"
                    name="action_open_intercompany_po"
                    invisible="not intercompany_po_id"
                >
                    <div class="o_stat_info">
                        <field name="intercompany_po_button_label" class="o_stat_text"/>
                        <field name="intercompany_po_id" string="" readonly="1"/>
                    </div>
                </button>
            </xpath>

        </field>
    </record>

</odoo>
