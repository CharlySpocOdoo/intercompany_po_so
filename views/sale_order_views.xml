<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Hereda la vista formulario de Sale Order para agregar el campo intercompañía -->
    <record id="sale_order_intercompany_form_view" model="ir.ui.view">
        <field name="name">sale.order.intercompany.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!--
                Insertamos el campo justo después del campo 'name' (número de SO)
                visible solo cuando existe una PO vinculada.
            -->
            <xpath expr="//field[@name='name']" position="after">
                <field
                    name="intercompany_po_id"
                    string="Orden de Compra Origen"
                    readonly="1"
                    attrs="{'invisible': [('intercompany_po_id', '=', False)]}"
                    options="{'no_open': False}"
                />
            </xpath>

        </field>
    </record>

</odoo>
