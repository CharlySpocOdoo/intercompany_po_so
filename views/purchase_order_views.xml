<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Hereda la vista formulario de Purchase Order para agregar el campo intercompañía -->
    <record id="purchase_order_intercompany_form_view" model="ir.ui.view">
        <field name="name">purchase.order.intercompany.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!-- Smart button: abre la SO intercompañía desde el button_box de la PO -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    type="object"
                    name="action_open_intercompany_so"
                    invisible="not intercompany_so_id"
                >
                    <div class="o_stat_info">
                        <field name="intercompany_so_button_label" class="o_stat_text"/>
                        <field name="intercompany_so_id" string="" readonly="1"/>
                    </div>
                </button>
            </xpath>

        </field>
    </record>

</odoo>
