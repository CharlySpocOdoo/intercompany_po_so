<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Hereda la vista formulario de Purchase Order para agregar el campo intercompañía -->
    <record id="purchase_order_intercompany_form_view" model="ir.ui.view">
        <field name="name">purchase.order.intercompany.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!--
                Insertamos el campo justo después del campo 'name' (número de PO)
                en la cabecera del formulario, visible solo cuando ya existe una SO vinculada.
            -->
            <xpath expr="//field[@name='name']" position="after">
                <field
                    name="intercompany_so_id"
                    string="Cotización Intercompañía"
                    readonly="1"
                    widget="many2one_clickable"
                    attrs="{'invisible': [('intercompany_so_id', '=', False)]}"
                    options="{'no_open': False}"
                />
            </xpath>

        </field>
    </record>

</odoo>
